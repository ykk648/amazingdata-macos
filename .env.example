# Credentials and endpoint issued by China Galaxy Securities.
TGW_USER=
TGW_PASSWORD=
TGW_HOST=
TGW_PORT=8600

# Gateway settings. The Docker port is published to macOS loopback only.
AMAZINGDATA_HTTP_PORT=8765
AMAZINGDATA_API_KEY=
AMAZINGDATA_VERIFY_LOGIN=true
AMAZINGDATA_WATCHDOG_INTERVAL=180
AMAZINGDATA_WATCHDOG_FAILURES=2

# Optional stable superset used by the first real-time subscription session.
# Example: 510300.SH,600519.SH
AMAZINGDATA_SUBSCRIBE_CODES=
AMAZINGDATA_SUBSCRIBE_PERIOD=snapshot
